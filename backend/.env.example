# Entorno de ejecución del backend.
NODE_ENV=development

# Puerto donde escuchará el servidor HTTP.
PORT=3000

# Dirección local donde escuchará el backend.
HOST=127.0.0.1

# Origen permitido para el frontend durante el desarrollo.
CORS_ORIGIN=http://localhost:5173

# Dirección del servidor MySQL.
DATABASE_HOST=127.0.0.1

# Puerto habitual de MySQL.
DATABASE_PORT=3306

# Nombre propuesto para la base; lo confirmaremos en la fase 6.
DATABASE_NAME=la_veneziana

# Usuario de la aplicación; se configurará al preparar MySQL.
DATABASE_USER=

# Contraseña privada del usuario de MySQL.
# La plantilla se conserva vacía.
DATABASE_PASSWORD=

# Ruta al certificado de la autoridad certificadora para MySQL con TLS.
# Se completará cuando la conexión lo requiera.
DATABASE_CA=

# Secreto privado para firmar y verificar tokens JWT.
# La plantilla queda vacía; generaremos el valor solo para .env.
JWT_SECRET=