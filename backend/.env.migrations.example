# Entorno donde se ejecutarán las migraciones.
NODE_ENV=development

# Servidor MySQL del proyecto.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_NAME=la_veneziana

# Usuario con permisos para modificar la estructura.
DATABASE_USER=la_veneziana_migraciones

# Completar únicamente en .env.migrations.
DATABASE_PASSWORD=

# Ruta del certificado CA usado para verificar MySQL.
DATABASE_CA=