# Entorno de ejecución de producción.
NODE_ENV=production

# Puerto interno del backend.
PORT=3000

# Dirección de escucha para un despliegue detrás de un proxy local.
# Se ajustará según la infraestructura elegida.
HOST=127.0.0.1

# Origen HTTPS de ejemplo; reemplazar por el dominio real.
CORS_ORIGIN=https://pizzeria.example

# Dirección y puerto del servidor MySQL.
# Completar según la infraestructura de producción.
DATABASE_HOST=
DATABASE_PORT=3306

# Nombre propuesto para la base de datos.
DATABASE_NAME=la_veneziana

# Credenciales privadas del usuario de la aplicación.
# No guardar valores reales en esta plantilla.
DATABASE_USER=
DATABASE_PASSWORD=

# Ruta al certificado CA si la conexión MySQL utiliza TLS.
DATABASE_CA=

# Secreto privado generado para el entorno de producción.
# Mantener vacío en esta plantilla.
JWT_SECRET=