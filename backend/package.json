{
  "name": "la-veneziana-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor del sistema de la pizzería La Veneziana.",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "admin:recuperar": "node scripts/recuperar-admin.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "crm:habilitar": "node scripts/habilitar-clientes.js",
    "test:recetas": "node --test tests/recetas-calculo.test.js",
    "recetas:carta:validar": "node scripts/cargar-recetas-carta.mjs",
    "recetas:carta:cargar": "node scripts/cargar-recetas-carta.mjs --aplicar",
    "recetas:carta:mermas": "node scripts/cargar-recetas-carta.mjs --aplicar --merma",
    "proveedores:validar": "node scripts/cargar-proveedores-referencia.mjs",
    "proveedores:cargar": "node scripts/cargar-proveedores-referencia.mjs --aplicar",
    "compras:iniciales:validar": "node scripts/cargar-compras-iniciales.mjs",
    "compras:iniciales:cargar": "node scripts/cargar-compras-iniciales.mjs --aplicar",
    "compras:iniciales:saldar": "node scripts/saldar-compras-iniciales.mjs",
    "test:compras:iniciales:pago": "node tests/compras-iniciales-pago-integracion.mjs",
    "test:compras:iniciales": "node --test tests/compras-iniciales.test.mjs",
    "test:compras:iniciales:integracion": "node tests/compras-iniciales-integracion.mjs",
    "test:proveedores": "node --test tests/proveedores-referencia.test.mjs",
    "test:proveedores:integracion": "node tests/proveedores-referencia-integracion.mjs",
    "test:recetas:carta": "node --test tests/carta-recetas.test.mjs tests/carta-mermas.test.mjs",
    "test:recetas:carta:integracion": "node tests/carta-recetas-integracion.mjs",
    "test:inventario": "node --test tests/inventario-calculo.test.js",
    "test:inventario:integracion": "node tests/inventario-integracion.js",
    "test:inventario:monitor": "node tests/inventario-monitor-integracion.js",
    "test:compras": "node --test tests/compras-calculo.test.js",
    "test:compras:integracion": "node tests/compras-integracion.js",
    "test:pos:integracion": "node tests/pos-integracion.js",
    "carta:validar": "node scripts/importar-carta.mjs",
    "carta:importar": "node scripts/importar-carta.mjs --aplicar",
    "test:carta": "node --test tests/carta.test.mjs",
    "test:sesion:integracion": "node tests/sesion-integracion.mjs",
    "test:pedidos": "node --test tests/pedidos-calculo.test.mjs",
    "test:pedidos:integracion": "node tests/pedidos-integracion.mjs",
    "test:impresion": "node --test tests/impresion.test.mjs",
    "impresion:simular": "node scripts/agente-impresion.mjs",
    "test:caja": "node --test tests/caja-calculo.test.mjs",
    "test:caja:integracion": "node tests/caja-integracion.mjs",
    "test:salon:integracion": "node tests/salon-integracion.mjs",
    "test:salon:configuracion": "node --test tests/salon-configuracion.test.mjs",
    "test:salon:configuracion:integracion": "node tests/salon-configuracion-integracion.mjs",
    "test:mesas": "node --test tests/mesas-reglas.test.mjs",
    "test:mesas:integracion": "node tests/mesas-integracion.mjs",
    "test:modificadores:integracion": "node tests/modificadores-pedido-integracion.mjs",
    "test:kds": "node --test tests/kds-protocolo.test.mjs tests/kds-reglas.test.mjs",
    "test:kds:comandos": "node tests/kds-comandos-integracion.mjs",
    "test:kds:integracion": "node tests/kds-integracion.mjs",
    "test:reportes": "node --test tests/reportes-reglas.test.mjs",
    "test:reportes:integracion": "node tests/reportes-integracion.mjs"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "jsonwebtoken": "9.0.3",
    "mysql2": "3.24.6",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "sequelize": "6.37.8",
    "umzug": "3.8.3",
    "ws": "8.22.0"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    },
    "umzug": {
      "@rushstack/ts-command-line": {
        "argparse": "2.0.1"
      }
    }
  }
}
