{
  "name": "la-veneziana-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor del sistema de la pizzería La Veneziana.",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "jsonwebtoken": "9.0.3",
    "mysql2": "3.24.6",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "sequelize": "6.37.8",
    "umzug": "3.8.3"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    },
    "umzug": {
      "@rushstack/ts-command-line": {
        "argparse": "2.0.1"
      }
    }
  }
}
